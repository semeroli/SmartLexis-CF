# GEMINI_API_KEY: Required for Gemini TTS API (voice playback).
# Get it from: https://ai.google.dev/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# MODELSCOPE_API_KEY: Required for ModelScope AI API (student analysis, essay upgrade).
# Get it from: https://modelscope.cn/
# Can support multiple keys separated by comma: "key1,key2,key3"
MODELSCOPE_API_KEY="YOUR_MODELSCOPE_API_KEY_HERE"

# AGNES_API_KEY: Required for agnes-ai multimodal API (essay image recognition).
# Get it from: https://agnes-ai.com/
AGNES_API_KEY="YOUR_AGNES_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# Cloudflare Pages auto-injects this at runtime.
APP_URL="https://your-pages-dev.pages.dev"
